{
  "name": "autoshop-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:locales": "node scripts/generate-locales.mjs",
    "predev": "npm run generate:locales",
    "dev": "next dev",
    "prebuild": "npm run generate:locales",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "test": "node --env-file=.env.local --import tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.3",
    "next": "16.2.12",
    "next-intl": "^4.13.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.18",
      "sharp": "0.35.0"
    }
  }
}
